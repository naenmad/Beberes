<section id="features" class="py-20 border-t border-zinc-200/80 bg-zinc-50/50 dark:border-zinc-800/80 dark:bg-zinc-950/50">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="max-w-2xl">
      <span class="text-xs font-semibold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">Engineered for macOS</span>
      <h2 class="mt-2 text-3xl font-bold tracking-tight text-zinc-950 sm:text-4xl dark:text-white">
        Tools designed for how modern developers work
      </h2>
      <p class="mt-4 text-base text-zinc-600 dark:text-zinc-400 leading-relaxed">
        Most cleaner apps only empty your Trash and Safari cache. Beberes was created because software engineers regularly lose 50+ GB to invisible build directories and simulator runtimes.
      </p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {features.map((feat) => (
        <div class="group relative rounded-2xl border border-zinc-200/80 bg-white p-6 shadow-sm transition hover:border-zinc-300 dark:border-zinc-800/80 dark:bg-zinc-900/60 dark:hover:border-zinc-700/80 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-2">
              <span class="text-xs font-medium text-emerald-600 dark:text-emerald-400">{feat.category}</span>
              <span class="rounded-full bg-zinc-100 px-2 py-0.5 text-[11px] font-medium text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400">{feat.badge}</span>
            </div>
            <h3 class="mt-4 text-base font-semibold text-zinc-900 dark:text-zinc-100 group-hover:text-emerald-500 transition">
              {feat.title}
            </h3>
            <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
              {feat.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
