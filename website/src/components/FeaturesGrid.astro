    category: 'macOS Core',
    badge: 'APFS Aware',
    icon: 'hard-drive',
  },
  {
    title: 'Complete App Uninstaller & Leftover Hunter',
    description: 'Drag or select an app to reveal hidden files scattered across ~/Library/Application Support, Caches, Preferences, and Containers before deleting.',
    category: 'Hygiene',
    badge: 'Deep Search',
    icon: 'trash',
  },
  {
    title: 'Git Branch & Stash Sweeper',
    description: 'Inspects local git repositories to detect merged branches, stale git caches, and dangling objects, helping you keep your repos lean.',
    category: 'Git Tooling',
    badge: 'Safe Branching',
    icon: 'git-branch',
  },
  {
    title: 'Multi-Pass File Shredder',
    description: 'Permanently overwrites sensitive files using 1-pass zero-fill, 3-pass DoD 5220.22-M, or 7-pass Gutmann algorithms before unlinking.',
    category: 'Security',
    badge: 'Zero Recovery',
    icon: 'shield',
  },
  {
    title: 'Interactive Disk Visualizer & Duplicate Finder',
