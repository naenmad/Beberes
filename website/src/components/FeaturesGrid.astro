    badge: 'Save 20-50 GB',
    icon: 'code',
  },
  {
    title: 'Xcode & Simulator Runtime Stripper',
    description: 'Inspects and cleans DerivedData, Xcode Archives, DeviceSupport, and purges unavailable or orphaned iOS simulator runtimes with a single click.',
    category: 'Apple Devs',
    badge: 'Instant Relief',
    icon: 'smartphone',
  },
  {
    title: 'Zombie Port & Background Process Killer',
    description: 'Finds stuck processes locking common dev ports like 3000, 8080, or 5432 using native lsof. Protected PID safelist prevents killing macOS system daemons.',
