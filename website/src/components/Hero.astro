---
import { APP_CONFIG } from '../config';
---

<section class="relative overflow-hidden pt-12 pb-20 sm:pt-20 sm:pb-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="text-center max-w-3xl mx-auto">
      <!-- Tag badge -->
      <div class="inline-flex items-center gap-2 rounded-full border border-emerald-500/20 bg-emerald-500/10 px-3 py-1 text-xs font-medium text-emerald-600 dark:text-emerald-400 mb-6">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Version <span class="dynamic-version-badge">{APP_CONFIG.version}</span> now available for macOS</span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-4xl font-extrabold tracking-tight text-zinc-950 sm:text-6xl dark:text-white leading-[1.1]">
        Keep your Mac fast and spacious. Without the bloatware.
      </h1>

      <!-- Subtitle -->
      <p class="mt-6 text-lg text-zinc-600 dark:text-zinc-400 leading-relaxed max-w-2xl mx-auto">
        An open-source macOS utility written in Rust. Reclaim gigabytes from dormant project artifacts, Xcode simulator caches, and system leftovers with strict safety boundaries.
      </p>

      <!-- Primary Actions -->
      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
        <!-- Direct DMG Download -->
        <a
          href={APP_CONFIG.downloadDmgUrl}
          class="w-full sm:w-auto inline-flex items-center justify-center gap-3 rounded-xl bg-emerald-600 px-6 py-3.5 text-base font-semibold text-white shadow-sm hover:bg-emerald-500 transition active:scale-95 group"
        >
          <svg class="h-5 w-5 transition-transform group-hover:-translate-y-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          <span>Download for macOS</span>
          <span class="text-xs font-normal text-emerald-100 opacity-90 dynamic-dmg-size">(DMG)</span>
        </a>

        <!-- View Source on GitHub -->
        <a
          href={APP_CONFIG.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-xl border border-zinc-300/80 bg-white px-6 py-3.5 text-base font-semibold text-zinc-800 shadow-sm hover:bg-zinc-50 transition active:scale-95 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-200 dark:hover:bg-zinc-800/80"
        >
          <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          <span>Star on GitHub</span>
        </a>
      </div>

      <!-- Quick Platform Details -->
      <div class="mt-6 flex flex-wrap items-center justify-center gap-y-2 gap-x-6 text-xs text-zinc-500 dark:text-zinc-400">
        <span class="flex items-center gap-1.5">
          <svg class="h-4 w-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          Apple Silicon (M1/M2/M3/M4) & Intel
        </span>
        <span class="flex items-center gap-1.5">
          <svg class="h-4 w-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          Zero Ads & Telemetry
        </span>
        <span class="flex items-center gap-1.5">
          <svg class="h-4 w-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          Trash Recovery by Default
        </span>
      </div>
    </div>

    <!-- Hero Screenshot Showcase -->
    <div class="mt-14 sm:mt-16 mx-auto max-w-5xl">
      <div class="rounded-2xl border border-zinc-200/80 bg-zinc-100/50 p-2 sm:p-3 shadow-2xl dark:border-zinc-800/80 dark:bg-zinc-900/50">
        <!-- macOS Window Chrome Header -->
        <div class="flex items-center justify-between px-3 py-2 border-b border-zinc-200/60 dark:border-zinc-800/60 mb-2">
          <div class="flex items-center gap-2">
            <div class="h-3 w-3 rounded-full bg-rose-500/80"></div>
            <div class="h-3 w-3 rounded-full bg-amber-500/80"></div>
            <div class="h-3 w-3 rounded-full bg-emerald-500/80"></div>
          </div>
          <span class="text-xs font-medium text-zinc-500 dark:text-zinc-400">Beberes — Storage Dashboard</span>
          <div class="w-10"></div>
        </div>

        <img
          src="/screenshots/dashboard-hero.png"
          alt="Beberes Dashboard Interface Screenshot"
          class="w-full rounded-xl border border-zinc-200/50 dark:border-zinc-800/50 shadow-inner object-cover"
          loading="eager"
        />
      </div>
    </div>
  </div>
</section>
