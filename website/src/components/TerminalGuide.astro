---
const cliCommands = [
  {
    cmd: 'beberes scan',
    desc: 'Perform a comprehensive disk and cache analysis across system and developer directories.',
  },
  {
    cmd: 'beberes clean --dry-run',
    desc: 'Simulate cleanup and view exact reclaimable bytes without altering any files.',
  },
  {
    cmd: 'beberes kill-port 3000',
    desc: 'Locate and terminate any stuck zombie process holding TCP/UDP port 3000.',
  },
  {
    cmd: 'beberes hibernate ~/Developer',
    desc: 'Scan git repositories and hibernate inactive build artifacts (node_modules, target, etc.).',
  },
  {
    cmd: 'beberes xcode --purge-simulators',
    desc: 'Remove unavailable simulator runtimes and clear derived data.',
  },
];
---

<section class="py-20 border-t border-zinc-200/80 bg-zinc-900 text-zinc-100 dark:bg-black dark:border-zinc-800">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-5">
        <div class="inline-flex items-center gap-2 rounded-full bg-emerald-500/10 px-3 py-1 text-xs font-medium text-emerald-400 mb-4 border border-emerald-500/20">
          <span>Terminal Power</span>
        </div>
        <h2 class="text-3xl font-bold tracking-tight sm:text-4xl text-white">
          A full-featured CLI alongside the macOS GUI
        </h2>
        <p class="mt-4 text-sm text-zinc-400 leading-relaxed">
          Prefer the terminal or want to automate maintenance in cron jobs? Beberes includes a native CLI command line tool compiled directly from the same Rust engine.
        </p>
        <p class="mt-3 text-sm text-zinc-400 leading-relaxed">
          Install the symlink with one click in the app settings, or link manually:
        </p>
        
        <div class="mt-6 rounded-lg bg-zinc-950 p-4 border border-zinc-800 font-mono text-xs text-zinc-300">
          <div class="text-zinc-500"># Symlink to PATH</div>
          <span class="text-emerald-400">$</span> sudo ln -sf /Applications/Beberes.app/Contents/MacOS/beberes-app /usr/local/bin/beberes
        </div>

        <div class="mt-6">
          <a href="/docs/cli" class="inline-flex items-center gap-2 text-sm font-medium text-emerald-400 hover:text-emerald-300 transition">
            <span>Read complete CLI documentation</span>
            <span>&rarr;</span>
          </a>
        </div>
      </div>

      <div class="lg:col-span-7">
        <!-- Terminal Window Mock -->
        <div class="rounded-xl border border-zinc-800 bg-zinc-950 shadow-2xl overflow-hidden font-mono text-xs">
          <!-- Terminal Header -->
          <div class="flex items-center justify-between px-4 py-3 border-b border-zinc-800 bg-zinc-900/60">
            <div class="flex items-center gap-2">
              <div class="h-3 w-3 rounded-full bg-rose-500/80"></div>
              <div class="h-3 w-3 rounded-full bg-amber-500/80"></div>
              <div class="h-3 w-3 rounded-full bg-emerald-500/80"></div>
            </div>
            <span class="text-xs text-zinc-400">zsh — beberes</span>
            <div class="w-10"></div>
          </div>

          <!-- Terminal Content -->
          <div class="p-5 space-y-4 text-zinc-300">
            {cliCommands.map((c) => (
              <div>
                <div class="flex items-center gap-2">
                  <span class="text-emerald-400 font-bold">$</span>
                  <span class="text-white font-semibold">{c.cmd}</span>
                </div>
                <p class="mt-1 text-zinc-500 pl-4">{c.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
