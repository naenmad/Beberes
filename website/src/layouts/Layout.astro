---
import { APP_CONFIG } from '../config';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = `${APP_CONFIG.name} — High-Performance macOS Cleaner & Dev Optimizer`,
  description = APP_CONFIG.description,
  image = '/screenshots/dashboard-hero.png',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://beberes.app');
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/webp" href="/icon-beberes.webp" />
    <link rel="canonical" href={canonicalURL} />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Theme initialization script -->
    <script is:inline>
      const savedTheme = localStorage.getItem('beberes_theme');
      if (savedTheme === 'light' || (!savedTheme && window.matchMedia('(prefers-color-scheme: light)').matches)) {
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="min-h-screen bg-zinc-50 text-zinc-900 transition-colors duration-200 dark:bg-zinc-950 dark:text-zinc-100 flex flex-col">
    <!-- Top Navigation Header -->
    <header class="sticky top-0 z-50 border-b border-zinc-200/80 bg-zinc-50/80 backdrop-blur-md dark:border-zinc-800/80 dark:bg-zinc-950/80">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6">
        <a href="/" class="flex items-center gap-3 group">
          <img src="/icon-beberes.webp" alt="Beberes Logo" class="h-9 w-9 rounded-xl shadow-sm transition-transform group-hover:scale-105" />
          <div class="flex items-center gap-2">
            <span class="text-lg font-semibold tracking-tight text-zinc-900 dark:text-zinc-100">{APP_CONFIG.name}</span>
            <span class="rounded-full bg-emerald-500/10 px-2 py-0.5 text-xs font-medium text-emerald-600 dark:text-emerald-400" id="nav-version-badge">
              {APP_CONFIG.version}
            </span>
          </div>
        </a>

        <!-- Desktop Navigation Links -->
        <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-zinc-600 dark:text-zinc-400">
          <a href="/#features" class="transition hover:text-zinc-950 dark:hover:text-zinc-100">Features</a>
          <a href="/#developer-suite" class="transition hover:text-zinc-950 dark:hover:text-zinc-100">Developer Suite</a>
          <a href="/docs" class="transition hover:text-zinc-950 dark:hover:text-zinc-100">Documentation</a>
          <a href="/docs/cli" class="transition hover:text-zinc-950 dark:hover:text-zinc-100">CLI</a>
          <a href="/changelog" class="transition hover:text-zinc-950 dark:hover:text-zinc-100">Changelog</a>
        </nav>

        <!-- Right actions -->
        <div class="flex items-center gap-3">
          <!-- Theme Toggle -->
          <button
            id="theme-toggle"
            type="button"
            aria-label="Toggle theme"
            class="rounded-lg p-2 text-zinc-500 hover:bg-zinc-200/60 transition dark:text-zinc-400 dark:hover:bg-zinc-800/60"
          >
            <svg id="theme-icon-sun" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 9h-1m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
            <svg id="theme-icon-moon" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
            </svg>
          </button>

          <!-- GitHub link -->
          <a
            href={APP_CONFIG.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="hidden sm:flex items-center gap-1.5 rounded-lg border border-zinc-300/80 px-3 py-1.5 text-sm font-medium text-zinc-700 hover:bg-zinc-100 transition dark:border-zinc-800 dark:text-zinc-300 dark:hover:bg-zinc-900"
          >
            <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
            <span>GitHub</span>
          </a>

          <!-- Download Button -->
          <a
            href={APP_CONFIG.downloadDmgUrl}
            class="flex items-center gap-2 rounded-lg bg-emerald-600 px-3.5 py-1.5 text-sm font-medium text-white shadow-sm hover:bg-emerald-500 transition active:scale-95"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            <span>Download</span>
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content Slot -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Global Footer -->
    <footer class="border-t border-zinc-200 bg-white py-12 dark:border-zinc-800 dark:bg-zinc-950">
      <div class="mx-auto max-w-7xl px-4 sm:px-6">
        <div class="grid grid-cols-1 gap-8 md:grid-cols-4">
          <!-- Col 1: Brand -->
          <div class="md:col-span-2">
            <div class="flex items-center gap-3">
              <img src="/icon-beberes.webp" alt="Beberes Logo" class="h-8 w-8 rounded-lg" />
              <span class="text-base font-semibold text-zinc-900 dark:text-zinc-100">{APP_CONFIG.name}</span>
            </div>
            <p class="mt-3 text-sm text-zinc-600 dark:text-zinc-400 max-w-md">
              {APP_CONFIG.tagline} Free and open source under the {APP_CONFIG.license} license.
            </p>
            <div class="mt-4 flex items-center gap-4 text-xs text-zinc-500">
              <span>Universal: Apple Silicon & Intel</span>
              <span>•</span>
              <span>Requires macOS 11+</span>
            </div>
          </div>

          <!-- Col 2: Navigation -->
          <div>
            <h3 class="text-xs font-semibold uppercase tracking-wider text-zinc-900 dark:text-zinc-100">Product</h3>
            <ul class="mt-3 space-y-2 text-sm text-zinc-600 dark:text-zinc-400">
              <li><a href="/#features" class="hover:text-emerald-500 transition">Features</a></li>
              <li><a href="/#developer-suite" class="hover:text-emerald-500 transition">Developer Workspace</a></li>
              <li><a href="/docs/cli" class="hover:text-emerald-500 transition">Terminal CLI</a></li>
              <li><a href="/changelog" class="hover:text-emerald-500 transition">Changelog</a></li>
              <li><a href={APP_CONFIG.downloadDmgUrl} class="hover:text-emerald-500 transition">Download .dmg</a></li>
            </ul>
          </div>

          <!-- Col 3: Resources & Community -->
          <div>
            <h3 class="text-xs font-semibold uppercase tracking-wider text-zinc-900 dark:text-zinc-100">Community & Code</h3>
            <ul class="mt-3 space-y-2 text-sm text-zinc-600 dark:text-zinc-400">
              <li><a href={APP_CONFIG.githubUrl} target="_blank" rel="noopener noreferrer" class="hover:text-emerald-500 transition">GitHub Repository</a></li>
              <li><a href={`${APP_CONFIG.githubUrl}/issues`} target="_blank" rel="noopener noreferrer" class="hover:text-emerald-500 transition">Report an Issue</a></li>
              <li><a href="/docs/architecture" class="hover:text-emerald-500 transition">Architecture & Safety</a></li>
              <li><a href={APP_CONFIG.licenseUrl} target="_blank" rel="noopener noreferrer" class="hover:text-emerald-500 transition">GPL-3.0 License</a></li>
            </ul>
          </div>
        </div>

        <div class="mt-12 border-t border-zinc-200 pt-6 dark:border-zinc-800/80 flex flex-col sm:flex-row items-center justify-between text-xs text-zinc-500">
          <p>© {new Date().getFullYear()} Beberes. Crafted with Tauri v2, Rust & React.</p>
          <p class="mt-2 sm:mt-0">Independent open-source utility. Not affiliated with Apple Inc.</p>
        </div>
      </div>
    </footer>

    <!-- Client Script for Theme and Live Version Hydration -->
    <script>
      // Theme Toggle Handling
      const themeBtn = document.getElementById('theme-toggle');
      const sunIcon = document.getElementById('theme-icon-sun');
      const moonIcon = document.getElementById('theme-icon-moon');

      function updateThemeIcons() {
        const isDark = document.documentElement.classList.contains('dark');
        if (isDark) {
          sunIcon?.classList.remove('hidden');
          moonIcon?.classList.add('hidden');
        } else {
          sunIcon?.classList.add('hidden');
          moonIcon?.classList.remove('hidden');
        }
      }

      updateThemeIcons();

      themeBtn?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('beberes_theme', isDark ? 'dark' : 'light');
        updateThemeIcons();
      });

      // Client-side Version and Release Info Check
      async function syncLatestRelease() {
        try {
          const res = await fetch('https://api.github.com/repos/naenmad/Beberes/releases/latest');
          if (!res.ok) return;
          const release = await res.json();
          if (release.tag_name) {
            const navBadge = document.getElementById('nav-version-badge');
            if (navBadge) navBadge.textContent = release.tag_name;

            const heroBadges = document.querySelectorAll('.dynamic-version-badge');
            heroBadges.forEach(b => b.textContent = release.tag_name);

            // Find DMG asset size
            const dmgAsset = release.assets?.find((a: any) => a.name?.endsWith('.dmg'));
            if (dmgAsset && dmgAsset.size) {
              const sizeMb = (dmgAsset.size / (1024 * 1024)).toFixed(1);
              const sizeBadges = document.querySelectorAll('.dynamic-dmg-size');
              sizeBadges.forEach(b => b.textContent = `(~${sizeMb} MB)`);
            }
          }
        } catch (e) {
          // Gracefully keep static build-time version
        }
      }

      syncLatestRelease();
    </script>
  </body>
</html>
