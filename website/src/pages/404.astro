---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found — Beberes">
  <div class="py-24 text-center px-4 max-w-md mx-auto">
    <span class="text-sm font-semibold uppercase tracking-wider text-emerald-500">404</span>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-zinc-900 dark:text-white">Page not found</h1>
    <p class="mt-3 text-sm text-zinc-600 dark:text-zinc-400">
      Sorry, we couldn't find the page you're looking for.
    </p>
    <div class="mt-6">
      <a
        href="/"
        class="inline-flex items-center gap-2 rounded-lg bg-emerald-600 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-500 transition"
      >
        Return to Home
      </a>
    </div>
  </div>
</Layout>
